<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last updated: January 1, 2025"
            android:textColor="@color/colorGray"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/colorDivider" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="This app is provided free of charge and is intended for use as is. By installing and using the app, you agree to the collection and use of information described in this policy." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Information Collection and Use"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="The app may use third-party services (such as Google AdMob, Firebase Cloud Messaging, or OneSignal) that collect information used to identify you, including device identifiers, IP address, and usage statistics." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Log Data"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="In case of an error, the app collects data through third-party products called Log Data. This may include your device\'s IP address, device name, operating system version, app configuration, time and date of use, and other statistics." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Cookies"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="The app itself does not use cookies. However, third-party SDKs may use cookies to improve their services. You can choose to accept or refuse cookies, but refusing may limit functionality." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Service Providers"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="We may employ third-party companies and individuals to facilitate our Service, provide the Service on our behalf, perform Service-related tasks, or assist in analyzing app usage. These third parties have access to your information only to perform assigned tasks and are obligated not to disclose or use it for other purposes." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Notifications"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="The app may send push notifications using services such as Firebase Cloud Messaging or OneSignal. These services may collect device identifiers to deliver notifications. You can disable notifications at any time in your device settings." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Security"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="We value your trust and strive to use commercially acceptable means to protect your information. However, no method of transmission or storage is 100% secure." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Links to Other Sites"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="This app may contain links to external sites. We are not responsible for their content or privacy practices. Please review their policies separately." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Children\'s Privacy"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="This app does not target children under 13. We do not knowingly collect information from children. If such data is discovered, it will be deleted immediately." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Changes to This Policy"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="We may update this Privacy Policy from time to time. Changes will be posted within the app or on the hosting page." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Contact Us"
                    android:textColor="@color/colorBlue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:text="If you have questions or concerns, contact us at: techappsupport@gmail.com" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
