    <string name="about_description">TechApp is your go-to resource for the latest tech tips, tutorials, and app recommendations.</string>
    <string name="app_name">Etech Pro</string>
    <string name="btn_get_app">Get App</string>
    <string name="btn_send_email">Send Email</string>
    <string name="contact_email">support@techapp.com</string>
